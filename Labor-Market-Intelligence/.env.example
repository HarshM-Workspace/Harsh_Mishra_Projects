# ==============================================================================
# Labor Market Intelligence - Environment Configuration
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# GitHub Personal Access Token (for Search API - increases rate limit from 60 to 5,000/hr)
GitHub_access_token=your_github_pat_here

# Adzuna API Credentials (https://developer.adzuna.com/)
Adzuna_app_id=your_adzuna_app_id_here
Adzuna_api=your_adzuna_api_key_here

# MotherDuck Token (Optional for dev, required for prod warehouse sync)
MotherDuck_token=your_motherduck_token_here

# Local DuckDB path (optional override, defaults to ../labor_market.duckdb)
# DUCKDB_PATH=../labor_market.duckdb
